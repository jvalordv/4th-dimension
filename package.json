{
  "name": "4th-dimension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mathematically grounded 4D-to-3D visualizer: projection and slicing of four-dimensional objects.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "earcut": "^3.0.0",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
